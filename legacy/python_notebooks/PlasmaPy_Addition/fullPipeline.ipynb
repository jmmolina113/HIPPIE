   "source": [
    "import ipynb.fs.full.pipelineFunctions_full as pipelineFuncs\n",
    "import numpy as np\n",
    "import h5py\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.ndimage import gaussian_filter\n",
    "\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\",category = RuntimeWarning)\n",
    "\n",
    "# Parameters and File Paths\n",
    "parameters_location = \"HIPPIE_DATA_ROOT"\n",
    "shot_location = \"HIPPIE_DATA_ROOT"\n",
    "cal_location = \"HIPPIE_DATA_ROOT"\n",
    "shot_seq_port = \"191114_001_90-78\"\n",
    "filter_data_location = \"HIPPIE_DATA_ROOT"\n",
    "\n",
    "where_to_look = 1  # -1 -> left, 0 -> center, 1 -> right\n",
    "pinhole_to_use1 = [4, 1]\n",
    "pinhole_to_use2 = [4, 2]\n",
    "where_to_place_max = [800, 500]  # [X Y] (within a 1050 x 1050 pixel image)\n",
    "\n",
    "box_center = [-0.2, 0.6]  # in mm [x, y]\n",
    "box_size = [0.9, 0.7]  # in mm [height, width]\n",
    "\n",
    "manual_or_not = 1  # 1 for manual, 0 for not\n",
    "smooth_pixels = 10  # Pixels to smooth over for fitting purposes\n",
    "smoothing_type = 'gauss'\n",
    "bin_size = [1, 1]  # Bin dimensions\n",
    "how_to_bin = \"median\"  # Options: \"mean\", \"median\", \"geomean\"\n",
    "floor_value = 0  # Minimum count to keep\n",
    "temp_bound = [100, 1000]  # Temperature bounds\n",
    "flatfield = 1\n",
    "\n",
    "# Function calls\n",
    "Te, target_edge = pipelineFuncs.estimate_electron_temperature_2d_manual(shot_location, cal_location, shot_seq_port, parameters_location, where_to_look, \n",
    "    pinhole_to_use1, pinhole_to_use2, where_to_place_max, filter_data_location, \n",
    "    smoothing_type, smooth_pixels, bin_size, floor_value, how_to_bin, temp_bound, \n",
    "    manual_or_not, flatfield)\n",
    "\n",
    "params = pipelineFuncs.grab_params_v4(shot_seq_port, parameters_location)\n",
    "temperature, error = pipelineFuncs.extract_average_temperature(np.flipud(Te[:, :, 0]), box_center, box_size, where_to_place_max, params, target_edge, 400)\n",
    "\n"
   ]
  },
