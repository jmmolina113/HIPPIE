    "    file_location_and_name = f\"{parameters_location}{file_name}\"\n",
    "    \n",
    "    # Read in data and convert to a cell-like structure\n",
    "    data = pd.read_excel(file_location_and_name)\n",
    "    table = data.values.tolist()\n",
    "    \n",
    "    # Determine which column to use based on Date_Seq\n",
    "    date_to_work_with = [i for i, x in enumerate(table[0]) if str(x) == Date_Seq]\n",
    "    \n",
    "    if not date_to_work_with:\n",
