    "        'volt': ast.literal_eval(table[6][date_to_work_with]),\n",
    "        'dt': ast.literal_eval(table[7][date_to_work_with]),\n",
    "        'vpulse': float(table[8][date_to_work_with]),\n",
    "        'ccd_xwidth': float(table[9][date_to_work_with]),\n",
    "        'ccd_ywidth': float(table[10][date_to_work_with]),\n",
    "        'mirror': float(table[11][date_to_work_with])\n",
