    "\n",
    "def process_pinholes(inputPinhole, maximaCoords, floorValue):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    background = background_2d(inputPinhole, maximaCoords)  # Define the background_2D function in Python\n",
    "    pinhole_b = inputPinhole - background\n",
    "                \n",
    "    pinhole_bf = floor_pinhole_2d(pinhole_b, floorValue)\n",
    "\n",
    "    return pinhole_bf\n",
    "\n",
    "def read_hdf5_data(shot_location, cal_location):\n",
    "    import h5py\n",
    "    import numpy as np\n",
    "\n",
    "    # Read in the pre-shot data\n",
    "    with h5py.File(shot_location, 'r') as f:\n",
    "        preshot = f['/ATTRIBUTES/PRESHOT_IMAGESPRESHOT_IMAGES/0/DATA/DATA/'][:]\n",
    "        shot = f['/ATTRIBUTES/SHOT_IMAGE/DATA/DATA/'][:]\n",
    "    \n",
    "    # Convert data types to int32\n",
    "    preshot = preshot.astype(np.int32)\n",
    "    shot = shot.astype(np.int32)\n",
    "    \n",
    "    # Background subtraction\n",
    "    shot_data = shot - preshot\n",
    "    shot_data[shot_data < 0] = 0  # Set negative values to 0\n",
    "\n",
    "    # Read in calibration preshot and shot data\n",
    "    with h5py.File(cal_location, 'r') as f:\n",
    "        cal_preshot = f['/ATTRIBUTES/PRESHOT_IMAGESPRESHOT_IMAGES/0/DATA/DATA/'][:]\n",
    "        cal_shot = f['/ATTRIBUTES/SHOT_IMAGE/DATA/DATA/'][:]\n",
    "    \n",
    "    # Convert calibration data types to int32\n",
    "    cal_preshot = cal_preshot.astype(np.int32)\n",
    "    cal_shot = cal_shot.astype(np.int32)\n",
    "    \n",
    "    # Background subtraction\n",
    "    cal_data = cal_shot - cal_preshot\n",
    "    cal_data[cal_data < 0] = 0  # Set negative values to 0\n",
    "\n",
    "    # Convert to single precision (float32)\n",
    "    shot_data = shot_data.astype(float)\n",
    "    cal_data = cal_data.astype(float)\n",
    "    \n",
    "    return shot_data, cal_data\n",
    "\n",
    "\n",
    "def real_units_to_pixels(x, params):\n",
    "\n",
    "    return (1050 * (4/36) * x * params['mag'])\n",
    "\n",
    "\n",
    "def select_pinhole_2d(RawData, row, col, max_row, max_col, smooth_type, smooth_pixels, location, smoothing_on_off):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "    from scipy.ndimage import gaussian_filter\n",
    "   \n",
    "    Master_array = np.full((6200, 6200), np.nan, dtype=float)\n",
    "    Size_x, Size_y = RawData.shape\n",
    "    Master_array[1000:(Size_x+1000), 1000:(Size_y+1000)] = RawData\n",
    "\n",
    "    n = Size_x / 4\n",
    "    m = Size_y / 4\n",
    "\n",
    "    x = np.arange((col-1)*m, col*m+1, 1).astype(int)\n",
    "    y = np.arange((row-1)*n, row*n+1, 1).astype(int)\n",
    "\n",
    "    if x.min() == 0:\n",
    "        x += 1\n",
    "    if y.min() == 0:\n",
    "        y += 1\n",
    "\n",
    "    max_x_to_smooth = x.max() + 300\n",
    "    max_y_to_smooth = y.max() + 300\n",
    "\n",
    "    min_x_to_smooth = x.min() - 300\n",
    "    min_y_to_smooth = y.min() - 300\n",
    "\n",
    "    x_smoothing_range = np.arange(min_x_to_smooth, max_x_to_smooth+1, 1).astype(int)\n",
    "    y_smoothing_range = np.arange(min_y_to_smooth, max_y_to_smooth+1, 1).astype(int)\n",
    "    \n",
    "    \n",
    "    Array_to_smooth = Master_array[(min_y_to_smooth+999):(max_y_to_smooth+999), (min_x_to_smooth+999):(max_x_to_smooth+999)]\n",
    "    #Array_to_smooth = Master_array[y_smoothing_range+999, x_smoothing_range+999]\n",
    "\n",
    "    if smooth_type == \"mean\":\n",
    "        Smoothed_array = np.apply_along_axis(lambda m: np.convolve(m, np.ones(smooth_pixels)/smooth_pixels, mode='same'), axis=0, arr=Array_to_smooth)\n",
    "        Smoothed_array = np.apply_along_axis(lambda m: np.convolve(m, np.ones(smooth_pixels)/smooth_pixels, mode='same'), axis=1, arr=Smoothed_array)\n",
    "    elif smooth_type == \"gauss\":\n",
    "        Smoothed_array = gaussian_filter(Array_to_smooth, smooth_pixels)\n",
    "\n",
    "    Unsmoothed_data = Master_array\n",
    "\n",
    "    \n",
    "    Master_array[(min_y_to_smooth+999):(max_y_to_smooth+999), (min_x_to_smooth+999):(max_x_to_smooth+999)] = Smoothed_array\n",
    "    Smoothed_master_array = Master_array\n",
    "    \n",
    "\n",
    "    Guess_region_1 = Smoothed_master_array[(y.min()+999):(y.max()+999), (x.min()+999):(x.max()+999)] #should be 999\n",
    "\n",
    "\n",
    "    if location == -1:\n",
    "        guess_lower_bound_in_y = 250\n",
    "        guess_lower_bound_in_x = 125\n",
    "    elif location == 0:\n",
    "        guess_lower_bound_in_x = 400\n",
    "        guess_lower_bound_in_y = 50\n",
    "    elif location == 1:\n",
    "        guess_lower_bound_in_x = 500\n",
    "        guess_lower_bound_in_y = 250\n",
    "\n",
    "    Guess_region_2 = Guess_region_1[guess_lower_bound_in_y:800, guess_lower_bound_in_x:900]\n",
    "    old_y_max_location_in_guess_2, old_x_max_location_in_guess_2 = np.unravel_index(np.argmax(Guess_region_2, axis=None), Guess_region_2.shape)\n",
    "    old_y_max_location = old_y_max_location_in_guess_2 + guess_lower_bound_in_y\n",
    "    old_x_max_location = old_x_max_location_in_guess_2 + guess_lower_bound_in_x\n",
    "\n",
    "    diff_x = max_col - old_x_max_location\n",
    "    diff_y = max_row - old_y_max_location\n",
    "\n",
    "    #Corrected_x_range = x - diff_x + 999\n",
    "    #Corrected_y_range = y - diff_y + 999\n",
    "\n",
    "    if smoothing_on_off == 1:\n",
    "        Final = Smoothed_master_array[(y.min()-diff_y+999):(y.max()-diff_y+999), (x.min()-diff_x+999):(x.max()-diff_x+999)]\n",
    "    else:\n",
    "        Final = Unsmoothed_data[(y.min()-diff_y+999):(y.max()-diff_y+999), (x.min()-diff_x+999):(x.max()-diff_x+999)]\n",
    "\n",
    "    Guess_region_2 = Final[475:525, 475:525]\n",
    "    new_y_max_location, new_x_max_location = np.unravel_index(np.argmax(Guess_region_2, axis=None), Guess_region_2.shape)\n",
    "    new_y_max_location += 474\n",
    "    new_x_max_location += 474\n",
    "       \n",
    "    return Final, new_x_max_location, new_y_max_location\n",
    "        \n",
    "def switch_pinholes(pinhole1, pinhole2):\n",
    "    import numpy as np\n",
    "\n",
    "    #This function is used to flip the data, as the pipeline assumes \n",
    "    #that the left pinhole in the isolated pair is the high-signal, low-filtered pinhole,\n",
    "    #and the right pinhole is the low-signal, high-filtered pinhole.\n",
    "            \n",
    "    if np.mean(pinhole2[474:525, 474:575]) > np.mean(pinhole1[474:525, 474:575]):\n",
    "        didSwitch = 1\n",
    "        pinhole1_new = pinhole2\n",
    "        pinhole2_new = pinhole1\n",
    "    else:\n",
    "        didSwitch = 0\n",
    "        pinhole1_new = pinhole1\n",
    "        pinhole2_new = pinhole2\n",
    "\n",
    "    return pinhole1_new, pinhole2_new, didSwitch\n",
    "\n",
    "    \n",
    "def gaussian(x, a, b, c):\n",
    "    return a * np.exp(-((x - b) ** 2) / (2 * c ** 2))\n",
    "\n",
    "\n",
    "def target_edge_finder(inputPinhole, vertMax, horzMax, averageRange):\n",
    "\n",
    "    #This function is designed for locating the edge of a given target.\n",
    "    from scipy.optimize import curve_fit\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    lineout = np.mean(inputPinhole[:, (horzMax-round(averageRange)):(horzMax+round(averageRange))], axis=1)\n",
    "    lineoutToFit = lineout\n",
    "   \n",
    "    regionToFit = lineoutToFit[:vertMax - 10]\n",
    "\n",
    "    pixelSpace = np.arange(1, len(regionToFit) + 1)\n",
    "        \n",
    "    whereAreNans = np.isnan(regionToFit)\n",
    "    whereAreNonNans = [not elem for elem in whereAreNans]\n",
    "\n",
    "    # Fit the region with a Gaussian function\n",
    "    popt, _ = curve_fit(gaussian, pixelSpace[whereAreNonNans], regionToFit[whereAreNonNans])\n",
    "\n",
    "    # Calculate the maximum gradient to find the alignment point\n",
    "    gradient_values = np.gradient(gaussian(pixelSpace, *popt))\n",
    "    alignmentPoint = np.argmax(gradient_values)\n",
    "    \n",
    "    targetEdge = alignmentPoint\n",
    "\n",
    "    return targetEdge\n"
   ]
