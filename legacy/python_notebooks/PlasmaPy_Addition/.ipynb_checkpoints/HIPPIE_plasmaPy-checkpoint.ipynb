    "def background_2d(pinhole, maxima_coords):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    slice_ = pinhole[:, maxima_coords[1] - 50:maxima_coords[1] + 50]  # Isolating a slice around the maxima\n",
    "    \n",
    "    lineout = np.nanmean(slice_, axis=1)  # Creating a lineout with the non-nan values\n",
    "    #lineout = np.flip(lineout)  # Flipping the lineout to make the data easier\n",
    "\n",
    "    indices = np.isnan(lineout)  # Picking out the NaN values\n",
    "    lineout = lineout[~indices]\n",
    "    grad_lineout = np.abs(np.gradient(lineout))  # Taking the absolute of the gradient of the lineout\n",
    "\n",
    "    iteration = 0  # Initializing the while loop\n",
    "    background = []\n",
    "\n",
    "    while iteration < len(grad_lineout) and grad_lineout[iteration] < 0.2:\n",
    "        background.append(lineout[iteration])  # Keeping values in the lineout that satisfy the controlling expression\n",
    "        iteration += 1  # Incrementing the iteration\n",
    "    \n",
    "    if len(background) == 0:\n",
    "        reduced_image_lineout = np.nanmean(pinhole, axis=1, where=~np.isnan(pinhole))\n",
    "        lineout_to_use = np.flip(reduced_image_lineout)\n",
    "        background = np.nanmean(lineout_to_use[:10])\n",
    "    else:\n",
    "        background = np.nanmean(background)\n",
    "        \n",
    "    \n",
    "    return background\n",
    "\n",
    "def binning_algorithm_v2(pinhole, bin_x, bin_y, what_to_do):\n",
    "    \n",
    "    from scipy.stats import gmean\n",
    "    if bin_x == 1 and bin_y == 1:\n",
    "        return pinhole\n",
    "\n",
    "    # Initialize the binning algorithm\n",
    "    rows, cols = pinhole.shape\n",
    "    col_anchors = np.arange(bin_x, cols + bin_x, bin_x)\n",
    "    row_anchors = np.arange(bin_y, rows + bin_y, bin_y) - 1\n",
    "\n",
    "    if row_anchors[-1] != (rows - 1):\n",
    "        row_anchors = np.append(row_anchors, rows - 1)\n",
    "\n",
    "    if col_anchors[-1] != cols:\n",
    "        col_anchors = np.append(col_anchors, col_anchors[-1] + bin_x)\n",
    "\n",
    "    # Create the reduced image\n",
    "    reduced_pinhole = np.empty((len(row_anchors), len(col_anchors)))\n",
    "    reduced_pinhole[:] = np.nan\n",
    "\n",
    "    for new_row in range(len(row_anchors)):\n",
    "        for new_col in range(len(col_anchors)):\n",
    "            bin_values = np.full((bin_y, bin_x), np.nan)\n",
    "            cols_to_use = np.arange(col_anchors[new_col] - (bin_x - 1), col_anchors[new_col] + 1)\n",
    "            rows_to_use = np.arange(row_anchors[new_row] - (bin_y - 2), row_anchors[new_row] + 1)\n",
    "\n",
    "            for i in range(bin_x):\n",
    "                for j in range(bin_y):\n",
    "                    if (cols_to_use[i] >= cols) or (rows_to_use[j] >= rows):\n",
    "                        bin_values[j, i] = np.nan\n",
    "                    else:\n",
    "                        bin_values[j, i] = pinhole[rows_to_use[j], cols_to_use[i]]\n",
    "\n",
    "            if what_to_do == \"mean\":\n",
    "                reduced_pinhole[new_row, new_col] = np.nanmean(bin_values)\n",
    "            elif what_to_do == \"median\":\n",
    "                reduced_pinhole[new_row, new_col] = np.nanmedian(bin_values)\n",
    "            elif what_to_do == \"geomean\":\n",
    "                reduced_pinhole[new_row, new_col] = gmean(bin_values[~np.isnan(bin_values)])\n",
    "\n",
    "    return reduced_pinhole\n",
    "\n",
