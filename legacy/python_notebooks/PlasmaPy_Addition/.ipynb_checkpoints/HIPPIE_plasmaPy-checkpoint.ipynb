    "def calculate_temperature(R, S, temp_bound):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    " \n",
    "    \n",
    "    T = np.logspace(2, 4, 1001)  # Defining temperature range\n",
    "    Te = np.full(S.shape, np.nan)\n",
    "\n",
    "    for i in range(S.shape[0]):\n",
    "        for j in range(S.shape[1]):\n",
    "            Te[i, j] = find_temp(R, S[i, j], T)  # Finding\n",
    "            \n",
    "    return Te\n",
    "\n",
    "def calculate_theoretical_ratio(energies, temps, trans_coeffs):\n",
    "    import numpy as np\n",
    "    from scipy.special import kv  # Modified Bessel function of the second kind\n",
    "    from scipy.integrate import trapz\n",
    "    \n",
    "    # Initialize Integral array\n",
    "\n",
    "    integral = np.zeros(len(temps))\n",
    "    W = trans_coeffs  # Filter function\n",
    "\n",
    "    for i, temp in enumerate(temps):\n",
    "        B = kv(0, energies / (2 * temp))  # Modified Bessel function of the second kind (order 0)\n",
    "        expo = np.exp(-energies / (2 * temp))  # Exponential factor\n",
    "        K = detector_response(energies)  # Detector Response function (needs to be defined elsewhere)\n",
    "        \n",
    "        integrand = B * expo * W * K  # Product to integrate over\n",
    "        integral[i] = trapz(integrand, energies)  # Numerical integration using trapezoidal rule\n",
    "    \n",
    "    return integral\n",
    "\n",
    "def calculate_transmission_curves(filter_file_name1, filter_file_name2, filter_thickness1, filter_thickness2):\n",
    "    import numpy as np\n",
    "\n",
    "    if isinstance(filter_file_name2, (int, float)):\n",
    "        # Single filter\n",
    "        energy_data, transmission_curve_full = get_filter_transmission_v2(filter_file_name1, filter_thickness1, 0.1)\n",
    "    else:\n",
    "        # Multiple filters\n",
    "        energy_data, transmission_curve1_full = get_filter_transmission_v2(filter_file_name1, filter_thickness1, 0.1)\n",
    "        _, transmission_curve2_full = get_filter_transmission_v2(filter_file_name2, filter_thickness2, 0.1)\n",
    "        transmission_curve_full = transmission_curve1_full * transmission_curve2_full\n",
    "    \n",
    "    return energy_data, transmission_curve_full\n",
    "\n",
    "def detector_response(energy):\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    K = np.zeros_like(energy)\n",
    "    \n",
    "    for i, e in enumerate(energy):\n",
    "        if 10 <= e < 600:\n",
    "            K[i] = 40 * (10)**(1/4) * np.exp(-e * np.log(10) / 480)\n",
    "        elif 600 <= e <= 1800:\n",
    "            K[i] = 10 * (10)**(1/2) * np.exp(-e * np.log(10) / 1200)\n",
    "        else:\n",
    "            K[i] = 1\n",
    "    \n",
    "    return K\n",
    "\n",
