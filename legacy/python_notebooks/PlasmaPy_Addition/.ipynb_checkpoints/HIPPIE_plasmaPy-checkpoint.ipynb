    "def extract_filter_file_name(params, row, column, filter_data_location):\n",
    "    # Convert the (row, column) identifier method into the coordinate scheme of the excel sheet\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    value_to_select = (4 - row) * 4 + column - 1 #-1 is for python selection\n",
    "            \n",
    "    # Extract the filter material from the params file\n",
    "    filter_materials = params['filter_mat'][0]\n",
    "\n",
    "    filter_materials = filter_materials[value_to_select]    \n",
    "    filter_material = filter_materials.split(',')\n",
    "        \n",
    "    if len(filter_material) == 1:  # Single filter material\n",
    "        filter_file_name1 = f\"{filter_data_location}{filter_material[0]}_10.txt\"\n",
    "        filter_file_name2 = 0\n",
    "    elif len(filter_material) == 2:  # Two filter materials\n",
    "        filter_file_name1 = f\"{filter_data_location}{filter_material[0]}_10.txt\"\n",
    "        filter_file_name2 = f\"{filter_data_location}{filter_material[1]}_10.txt\"\n",
    "    else:  # Safeguard against more than two filter materials\n",
    "        raise ValueError(\"Too many filters. Readjust extract_filter_file_name.\")\n",
    "            \n",
    "    return filter_file_name1, filter_file_name2\n",
    "\n",
    "\n",
    "def extract_filter_thicknesses(params, row, column):\n",
    "    # Convert the (row, column) identifier method into the coordinate scheme of the excel sheet\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    value_to_select = (4 - row) * 4 + column - 1 # -1 is for python\n",
    "        \n",
    "    # Extract the filter thicknesses from the params file\n",
    "    filter_thicknesses = params['filter_thk']\n",
    "    filter_thickness = filter_thicknesses.iloc[value_to_select]\n",
    "    \n",
    "    pinhole_filters = filter_thicknesses.iloc[value_to_select]\n",
    "    \n",
    "    filter_thickness1 = pinhole_filters[0]\n",
    "    filter_thickness2 = pinhole_filters[1]\n",
    "    \n",
    "    if (np.isnan(filter_thickness2)):\n",
    "        filter_thickness2 = 0\n",
    "    \n",
    "    return filter_thickness1, filter_thickness2\n",
    "\n",
    "\n",
    "def filter_signal_ratio(signal_ratio):\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    # Filter out all the vacuum pixels from the signal ratio before calculating the electron temperature\n",
    "    signal_ratio_filtered = np.where(signal_ratio > 1, np.nan, signal_ratio)\n",
    "    return signal_ratio_filtered\n",
    "\n",
    "def find_temp(ratio, signal_ratio, temps):\n",
    "    # Find the temperature corresponding to the closest signal ratio\n",
    "    index = np.argmin(np.abs(ratio - signal_ratio))\n",
    "    return temps[index]\n",
    "\n",
    "def floor_pinhole_2d(pinhole, floor_value):\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    # Floor the image by setting all signal values below floor_value to NaN\n",
    "    pinhole_floored = np.where(pinhole < floor_value, np.nan, pinhole)\n",
    "    return pinhole_floored\n",
    "\n",
    "def get_filter_transmission_v2(file_name, new_thickness):\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "    \n",
    "    split_string = file_name.split('_')\n",
    "    material_name = split_string[0]\n",
    "    material_thickness = split_string[1].split('.')[0]\n",
    "    standard_thickness = float(material_thickness.split('um')[0])\n",
    "        \n",
    "    # Read data from the file\n",
    "    file_path = f\"{material_name}_{int(standard_thickness)}um.txt\"\n",
    "    data = pd.read_csv(file_path, delim_whitespace=True, header=None).to_numpy()\n",
    "    \n",
    "    energy_data = data[2:, 0]\n",
    "    transmission_coeff_data = data[2:, 1]\n",
    "    \n",
    "    transmission_coeff_data = transmission_coeff_data.astype(float)\n",
    "    energy_data = energy_data.astype(float)\n",
    "        \n",
    "    T = np.power(transmission_coeff_data, (new_thickness / standard_thickness))\n",
    " \n",
    "    return energy_data, T\n",
    "\n",
