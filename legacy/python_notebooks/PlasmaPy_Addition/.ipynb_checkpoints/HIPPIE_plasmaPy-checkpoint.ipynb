    "def extract_average_temperature(temperature_map, where_to_start_box, window_dimensions, where_to_place_max, params, target_edge, color_bar_limit):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    # Define the conversion factors\n",
    "    horizontal_conversion = temperature_map.shape[1] / 1051\n",
    "    vertical_conversion = temperature_map.shape[0] / 1051\n",
    "    \n",
    "    # Calculate coordinates\n",
    "    max_coords = [where_to_place_max[0] * horizontal_conversion, where_to_place_max[1] * vertical_conversion]\n",
    "    zero_point = [max_coords[0], target_edge]\n",
    "    \n",
    "    # Calculate starting point and box size\n",
    "    \n",
    "    starting_point = np.zeros([2,1])\n",
    "            \n",
    "    starting_point[0] = np.round(real_units_to_pixels(where_to_start_box[0], params)).astype(int)\n",
    "    starting_point[1] = np.round(real_units_to_pixels(where_to_start_box[1], params)).astype(int)\n",
    "\n",
    "    starting_point = [int(horizontal_conversion * starting_point[0] + zero_point[0]), \n",
    "                      int(zero_point[1] - vertical_conversion * starting_point[1])]\n",
    "        \n",
    "    box_size = np.zeros([2,1])\n",
    "    box_size[0] = np.round(real_units_to_pixels(window_dimensions[0], params)).astype(int)\n",
    "    box_size[1] = np.round(real_units_to_pixels(window_dimensions[1], params)).astype(int)\n",
    "    box_size = [int(horizontal_conversion * box_size[1]), int(vertical_conversion * box_size[0])]\n",
    "    \n",
    "    pixels_to_extract_x = np.arange(-box_size[0] // 2, box_size[0] // 2 + 1)\n",
    "    pixels_to_extract_y = np.arange(-box_size[1] // 2, box_size[1] // 2 + 1)\n",
    "    \n",
    "\n",
    "    box = np.full((len(pixels_to_extract_x), len(pixels_to_extract_y)), np.nan)\n",
    "    \n",
    "    for i in range(0,len(pixels_to_extract_x)):\n",
    "        for j in range(0,len(pixels_to_extract_y)):\n",
    "        \n",
    "            \n",
    "            box[i, j] = temperature_map[starting_point[1] + pixels_to_extract_y[j], starting_point[0] + pixels_to_extract_x[i]]\n",
    "    \n",
    "    # Update temperature map with NaNs\n",
    "    temperature_map[starting_point[1] + pixels_to_extract_y, starting_point[0] + pixels_to_extract_x.min()] = np.nan\n",
    "    temperature_map[starting_point[1] + pixels_to_extract_y, starting_point[0] + pixels_to_extract_x.max()] = np.nan\n",
    "    temperature_map[starting_point[1] + pixels_to_extract_y.min(), starting_point[0] + pixels_to_extract_x] = np.nan\n",
    "    temperature_map[starting_point[1] + pixels_to_extract_y.max(), starting_point[0] + pixels_to_extract_x] = np.nan\n",
    "    \n",
    "    # Calculate temperature and error\n",
    "    temperature = np.nanmean(box)\n",
    "    error = np.nanstd(box, ddof=1)\n",
    "    \n",
    "    # Calculate length scales\n",
    "    length_scale_x = pixels_to_real_units(np.arange(temperature_map.shape[1]) - where_to_place_max[0], params)\n",
    "    length_scale_y = pixels_to_real_units(np.arange(temperature_map[:target_edge, :].shape[0]) - target_edge, params)\n",
    "    \n",
    "    # Plotting\n",
    "    plt.figure()\n",
    "    plt.imshow(temperature_map[:target_edge, :], extent=[length_scale_x.min(), length_scale_x.max(), length_scale_y.min(), length_scale_y.max()], origin='lower', cmap='hot')\n",
    "    plt.colorbar(label=\"Temperature (eV)\")\n",
    "    plt.clim(100,color_bar_limit)\n",
    "    plt.xlabel(\"Length [mm]\", fontsize=15)\n",
    "    plt.ylabel(\"Length [mm]\", fontsize=15)\n",
    "    plt.xlim(length_scale_x.min() - 0.05, length_scale_x.max() + 0.05)\n",
    "    plt.ylim(length_scale_y.min() - 0.05, length_scale_y.max() + 0.05)\n",
    "    plt.title(\"Temperature Map\",)\n",
    "    plt.grid(False)\n",
    "    plt.show()\n",
    "    \n",
    "    return temperature, error\n",
