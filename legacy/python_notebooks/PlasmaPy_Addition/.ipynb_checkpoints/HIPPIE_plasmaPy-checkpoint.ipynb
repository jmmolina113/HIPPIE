    "\n",
    "def id_pinhole_maxima(pinhole, whereToLook):\n",
    "    import numpy as np\n",
    "    # This function locates the maxima of a given pinhole image of arbitrary size\n",
    "\n",
    "    length, width = pinhole.shape\n",
    "\n",
    "    if whereToLook in [-1, 1]:\n",
    "        xCoord = np.argmax(np.max(pinhole[length//2-10:length//2+10, width//2-10:width//2+25], axis=0))\n",
    "        xCoord = round(xCoord + width//2 - 10)\n",
    "\n",
    "        yCoord = np.argmax(pinhole[:, xCoord])\n",
    "\n",
    "        coords = [yCoord, xCoord]\n",
    "\n",
    "    elif whereToLook == 0:\n",
    "        xCoord = np.argmax(np.max(pinhole[length//2-25:length//2+25, width//2-50:width//2+50], axis=0))\n",
    "        xCoord = round(xCoord + width//2 - 50)\n",
    "\n",
    "        yCoord = np.argmax(pinhole[:, xCoord])\n",
    "\n",
    "        coords = [yCoord, xCoord]\n",
    "\n",
    "    return coords\n",
    "\n",
    "\n",
    "def isolate_region_of_interest(lineout, lineout2, error_pixels, Range):\n",
    "    import numpy as np\n",
    "    # Process w/o error\n",
    "    new_max = 500\n",
    "    bckgrnd = background(lineout)  # Calculating the Background\n",
    "    lineout_n = lineout[new_max::-1][new_max-Range:]  # Isolating the Region of Interest\n",
    "    lineout_n = lineout_n - bckgrnd  # Background subtraction\n",
    "    lineout_n = np.maximum(lineout_n, 0)  # Flooring the < 0 values\n",
    "    norm = np.max(lineout_n)  # Identifying the value of the max\n",
    "    lineout_n = (1/norm) * lineout_n  # Normalizing \n",
    "\n",
    "    bckgrnd = background(lineout2)\n",
    "    lineout2_n = lineout2[new_max::-1][new_max-Range:]\n",
    "    lineout2_n = lineout2_n - bckgrnd\n",
    "    lineout2_n = np.maximum(lineout2_n, 0)\n",
    "    lineout2_n = (1/norm) * lineout2_n\n",
    "\n",
    "    # Upper error bound calculation\n",
    "    new_max = 500 + error_pixels\n",
    "    lineout_u = lineout[new_max::-1][new_max-Range:]\n",
    "    lineout_u = lineout_u - bckgrnd\n",
    "    lineout_u = np.maximum(lineout_u, 0)\n",
    "    norm = np.max(lineout_u)\n",
    "    lineout_u = (1/norm) * lineout_u\n",
    "\n",
    "    lineout2_u = lineout2[new_max::-1][new_max-Range:]\n",
    "    lineout2_u = lineout2_u - bckgrnd\n",
    "    lineout2_u = np.maximum(lineout2_u, 0)\n",
    "    lineout2_u = (1/norm) * lineout2_u\n",
    "\n",
    "    # Lower Bound\n",
    "    new_max = 500 - error_pixels\n",
    "    lineout_L = lineout[new_max::-1][new_max-Range:]\n",
    "    lineout_L = lineout_L - bckgrnd\n",
    "    lineout_L = np.maximum(lineout_L, 0)\n",
    "    norm = np.max(lineout_L)\n",
    "    lineout_L = (1/norm) * lineout_L\n",
    "\n",
    "    lineout2_L = lineout2[new_max::-1][new_max-Range:]\n",
    "    lineout2_L = lineout2_L - bckgrnd\n",
    "    lineout2_L = np.maximum(lineout2_L, 0)\n",
    "    lineout2_L = (1/norm) * lineout2_L\n",
    "\n",
    "    full_lineout = np.concatenate([lineout_u, lineout_n, lineout_L])\n",
    "    full_lineout2 = np.concatenate([lineout2_u, lineout2_n, lineout2_L])\n",
    "\n",
    "    return full_lineout, full_lineout2\n",
    "\n",
    "\n",
    "def make_processed_data_v2(shot_location, cal_location, parameters_location, shot_seq_port, flatfield):\n",
    "    params = grab_params_v4(shot_seq_port, parameters_location)\n",
    "    cal_params = grab_cal_params_v2(params['cal_shot'], parameters_location)\n",
    "    shot_data, cal_data = read_hdf5_data(shot_location, cal_location)\n",
    "    \n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    ang = (2 * np.pi / 360) * params['ang']\n",
    "    rot = np.array([[np.cos(ang), -np.sin(ang)], [np.sin(ang), np.cos(ang)]])\n",
    "    shot_data = mirror(shot_data, params['mirror'])\n",
    "    cal_data = mirror(cal_data, cal_params['mirror'])\n",
    "    avg = np.mean(cal_data)\n",
    "    flatfield = cal_data / avg\n",
    "\n",
    "    flatfield[flatfield == 0] = 1\n",
    "    raw_data = shot_data / flatfield\n",
    "\n",
    "    return raw_data\n",
    "\n",
    "def manual_pinhole_alignment(pinhole1, pinhole2, perp_range, where_to_place_max):\n",
    "    \n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "    \n",
    "    keep_going = 1\n",
    "    shift_x = 0\n",
    "    shift_y = 0\n",
    "    pinhole1_to_work_with = np.copy(pinhole1)\n",
    "    pinhole2_to_work_with = np.copy(pinhole2)\n",
    "    imbed_length = 200\n",
    "    imbeded_space = np.full((pinhole2.shape[0] + imbed_length, pinhole2.shape[1] + imbed_length), np.nan)\n",
    "    range_y = slice(imbed_length // 2, imbed_length // 2 + pinhole2.shape[0])\n",
    "    range_x = slice(imbed_length // 2, imbed_length // 2 + pinhole2.shape[1])\n",
    "    imbeded_space[range_y, range_x] = pinhole2_to_work_with\n",
    "\n",
    "    vertical_region_to_draw = slice(where_to_place_max[1] - 2, where_to_place_max[1] + 3)\n",
    "    horz_region_to_draw = slice(where_to_place_max[0] - 2, where_to_place_max[0] + 3)\n",
    "    vertical_lineout1 = np.nanmean(pinhole1_to_work_with[:, vertical_region_to_draw], axis=1)\n",
    "    horz_lineout1 = np.nanmean(pinhole1_to_work_with[horz_region_to_draw, :], axis=0)\n",
    "\n",
    "    pinhole1_to_work_with[:, vertical_region_to_draw] = np.nan\n",
    "    pinhole1_to_work_with[horz_region_to_draw, :] = np.nan\n",
    "\n",
    "\n",
    "    fig, ax = plt.subplots(2, 3, figsize=(20, 10))\n",
    "\n",
    "    ax[0, 0].imshow(pinhole1_to_work_with, aspect='auto', vmin=0, vmax=1200)\n",
    "    ax[0, 0].set_title('Pinhole 1 - Fixed')\n",
    "    ax[0, 0].set_xlabel('CCD Width (Pixels)')\n",
    "    ax[0, 0].set_ylabel('CCD Length (Pixels)')\n",
    "    ax[0, 0].grid(True)\n",
    "\n",
    "    ax[0, 1].plot(vertical_lineout1, 'b', linewidth=2.5)\n",
    "    ax[0, 1].axvline(where_to_place_max[0], color='k', linewidth=2.5)\n",
    "    ax[0, 1].set_title('Vertical Lineout Down Maxima of Pinhole 1')\n",
    "    ax[0, 1].set_xlabel('CCD Length (Pixels)')\n",
    "    ax[0, 1].set_ylabel('Counts (Arb. Units)')\n",
    "\n",
    "    ax[0, 2].plot(horz_lineout1, 'r', linewidth=2.5)\n",
    "    ax[0, 2].axvline(where_to_place_max[1], color='k', linewidth=2.5)\n",
    "    ax[0, 2].set_title('Horizontal Lineout Through Maxima of Pinhole 1')\n",
    "    ax[0, 2].set_xlabel('CCD Width (Pixels)')\n",
    "    ax[0, 2].set_ylabel('Counts (Arb. Units)')\n",
    "\n",
    "    while keep_going == 1:\n",
    "        pinhole2_to_work_with = imbeded_space[range_y.start - shift_y:range_y.stop - shift_y, range_x.start - shift_x:range_x.stop - shift_x]\n",
    "        vertical_lineout2 = np.nanmean(pinhole2_to_work_with[:, vertical_region_to_draw], axis=1)\n",
    "        horz_lineout2 = np.nanmean(pinhole2_to_work_with[horz_region_to_draw, :], axis=0)\n",
    "\n",
    "        pinhole2_for_plotting = np.copy(pinhole2_to_work_with)\n",
    "        pinhole2_for_plotting[:, vertical_region_to_draw] = np.nan\n",
    "        pinhole2_for_plotting[horz_region_to_draw, :] = np.nan\n",
    "        \n",
    "        ax[1, 0].imshow(pinhole2_for_plotting, aspect='auto', vmin=0, vmax=500)\n",
    "        ax[1, 0].set_title('Pinhole 2 - Mutable')\n",
    "        ax[1, 0].set_xlabel('CCD Width (Pixels)')\n",
    "        ax[1, 0].set_ylabel('CCD Length (Pixels)')\n",
    "        ax[1, 0].grid(True)\n",
    "\n",
    "        ax[1, 1].plot(vertical_lineout2, 'b', linewidth=2.5)\n",
    "        ax[1, 1].axvline(where_to_place_max[0], color='k', linewidth=2.5)\n",
    "        ax[1, 1].set_title('Vertical Lineout of Pinhole 2 Down Maxima of Pinhole 1')\n",
    "        ax[1, 1].set_xlabel('CCD Length (Pixels)')\n",
    "        ax[1, 1].set_ylabel('Counts (Arb. Units)')\n",
    "\n",
    "        ax[1, 2].plot(horz_lineout2, 'r', linewidth=2.5)\n",
    "        ax[1, 2].axvline(where_to_place_max[1], color='k', linewidth=2.5)\n",
    "        ax[1, 2].set_title('Horizontal Lineout of Pinhole 2 Through Maxima of Pinhole 1')\n",
    "        ax[1, 2].set_xlabel('CCD Width (Pixels)')\n",
    "        ax[1, 2].set_ylabel('Counts (Arb. Units)')\n",
    "\n",
    "        plt.draw()\n",
    "\n",
    "        keep_going = int(input(\"Would you like to adjust Pinhole 2? (1 == Yes, 0 == No): \"))\n",
    "\n",
    "        if keep_going == 1:\n",
    "            new_shift_x = int(input(\"Please enter the HORIZONTAL adjustment to Pinhole 2 in pixels ([+] integers move the image RIGHT, [-] integers move the image LEFT): \"))\n",
    "            new_shift_y = int(input(\"Please enter the VERTICAL adjustment to Pinhole 2 in pixels ([+] integers move the image UP, [-] integers move the image DOWN): \"))\n",
    "\n",
    "            shift_x += new_shift_x\n",
    "            shift_y -= new_shift_y\n",
    "\n",
    "    print(\"Alignment Done!\")\n",
    "    aligned_pinhole2 = imbeded_space[range_y.start - shift_y:range_y.stop - shift_y, range_x.start - shift_x:range_x.stop - shift_x]\n",
    "\n",
    "    return aligned_pinhole2\n",
    "\n",
    "\n",
    "def mirror(data, flip_number):\n",
    "    import numpy as np\n",
    "\n",
    "    if flip_number == 1:\n",
    "        # Y axis\n",
    "        shot_data = np.flip(data, axis=0)\n",
    "        shot_data = np.rot90(shot_data)\n",
    "\n",
    "    elif flip_number == 2:\n",
    "        # X axis and Y Axis\n",
    "        shot_data = np.flip(data, axis=1)\n",
    "        shot_data = np.flip(shot_data, axis=0)\n",
    "        shot_data = np.rot90(shot_data)\n",
    "\n",
    "    elif flip_number == 3:\n",
    "        # Just X Axis\n",
    "        shot_data = np.flip(data, axis=1)\n",
    "        shot_data = np.rot90(shot_data)\n",
    "\n",
    "    return shot_data\n",
    "\n",
    "\n",
    "def normalize_v2(lineout, where_to_look):\n",
    "    import numpy as np\n",
    "\n",
    "    first_nan_index = np.isnan(lineout).argmin()\n",
    "    section_constant = round(len(lineout) / 3)\n",
    "    \n",
    "    if where_to_look == -1:\n",
    "        norm_range = slice(first_nan_index, section_constant)\n",
    "    elif where_to_look == 0:\n",
    "        norm_range = slice(section_constant, 2 * section_constant)\n",
    "    elif where_to_look == 1:\n",
    "        norm_range = slice(2 * section_constant, 3 * section_constant)\n",
    "    \n",
    "    norm = np.nanmax(lineout[norm_range])\n",
    "    normalized_lineout = lineout / norm\n",
    "    return normalized_lineout\n",
    "\n",
    "\n",
    "def pinhole_analysis_2d_manual(shot_location, cal_location, parameters_location, shot_seq_port, row1, col1, row2, col2, \n",
    "                               smoothing_type, smooth_pixels, where_to_look, where_to_place_max, perp_range, bin_size, \n",
    "                               floor_value, how_to_bin, params, manual_or_not, flatfield):\n",
    "    import numpy as np\n",
    "\n",
    "    \n",
    "    # Creating Raw Data + Isolating Pinholes\n",
    "    raw_data = make_processed_data_v2(shot_location, cal_location, parameters_location, shot_seq_port, flatfield)\n",
    "    \n",
    "    pinhole1,p1_max_x,p1_max_y = select_pinhole_2d(raw_data, row1, col1, where_to_place_max[0], where_to_place_max[1], \n",
    "                                 smoothing_type, smooth_pixels, where_to_look, 1)\n",
    "    pinhole2,p2_max_x,p2_max_y = select_pinhole_2d(raw_data, row2, col2, where_to_place_max[0], where_to_place_max[1], \n",
    "                                 smoothing_type, smooth_pixels, where_to_look, 1)\n",
    "      \n",
    "    pinhole1, pinhole2, did_switch = switch_pinholes(pinhole1, pinhole2)\n",
    "    \n",
    "    # Aligning the Pinholes\n",
    "    if manual_or_not == 0:  # Automated Alignment Algorithm\n",
    "        pinhole2_aligned, target_edge = align_pinholes_2d_v2(pinhole1, pinhole2, where_to_look, perp_range, where_to_place_max)\n",
    "        pinhole1_aligned = pinhole1\n",
    "    elif manual_or_not == 1:  # Manual Alignment\n",
    "        pinhole2_aligned, target_edge = manual_pinhole_alignment(pinhole1, pinhole2, perp_range, where_to_place_max)\n",
    "        pinhole1_aligned = pinhole1\n",
    "    \n",
    "    pinhole1_final = process_pinholes(pinhole1_aligned, where_to_place_max, floor_value)\n",
    "    pinhole2_final = process_pinholes(pinhole2_aligned, where_to_place_max, floor_value)\n",
    "    \n",
    "    pinhole1_final[:target_edge,:] = np.nan\n",
    "    pinhole2_final[:target_edge,:] = np.nan\n",
    "\n",
    "    length_scale_x = pixels_to_real_units(np.arange(len(pinhole1_final)) - where_to_place_max[1], params)\n",
    "    length_scale_y = pixels_to_real_units(np.arange(target_edge) - target_edge, params)\n",
    "    \n",
    "    plotArray(pinhole1_final)\n",
    "    plotArray(pinhole2_final)\n",
    "\n",
    "    # Processing Pinholes + Constructing the S matrices\n",
    "    s_initial = pinhole2_final / pinhole1_final\n",
    "    #s = binning_algorithm_v2(s_initial, bin_size[0], bin_size[1], how_to_bin)\n",
    "    s = s_initial\n",
    "    \n",
    "    \n",
    "    error_matrix = np.full((pinhole2_final.shape[0] + 500, pinhole2_final.shape[1] + 500), np.nan)\n",
    "    imbed_range = np.arange(pinhole2_final.shape[0]) + 250\n",
    "    \n",
    "    error_matrix[imbed_range[:, None], imbed_range] = pinhole2_final\n",
    "    \n",
    "    error_shift = round(real_units_to_pixels(0.05, params))\n",
    "    \n",
    "    upper_error_bound_h = error_matrix[imbed_range[:, None], imbed_range + error_shift]\n",
    "    lower_error_bound_h = error_matrix[imbed_range[:, None], imbed_range - error_shift]\n",
    "    \n",
    "    upper_error_bound_v = error_matrix[imbed_range + error_shift, imbed_range[:, None]]\n",
    "    lower_error_bound_v = error_matrix[imbed_range - error_shift, imbed_range[:, None]]\n",
    "    \n",
    "    s_horizontal_upper_bound = upper_error_bound_h / pinhole1_final\n",
    "    s_horizontal_lower_bound = lower_error_bound_h / pinhole1_final\n",
    "    \n",
    "    s_vertical_upper_bound = upper_error_bound_v / pinhole1_final\n",
    "    s_vertical_lower_bound = lower_error_bound_v / pinhole1_final\n",
    "    \n",
    "    s_horizontal_upper_bound = binning_algorithm_v2(s_horizontal_upper_bound, bin_size[0], bin_size[1], how_to_bin)\n",
    "    s_horizontal_lower_bound = binning_algorithm_v2(s_horizontal_lower_bound, bin_size[0], bin_size[1], how_to_bin)\n",
    "    \n",
    "    s_vertical_upper_bound = binning_algorithm_v2(s_vertical_upper_bound, bin_size[0], bin_size[1], how_to_bin)\n",
    "    s_vertical_lower_bound = binning_algorithm_v2(s_vertical_lower_bound, bin_size[0], bin_size[1], how_to_bin)\n",
    "    \n",
    "    s_total = np.zeros((s.shape[0], s.shape[1], 5))\n",
    "    s_total[:, :, 0] = s\n",
    "    s_total[:, :, 1] = s_horizontal_upper_bound\n",
    "    s_total[:, :, 2] = s_horizontal_lower_bound\n",
    "    s_total[:, :, 3] = s_vertical_upper_bound\n",
    "    s_total[:, :, 4] = s_vertical_lower_bound\n",
    "    \n",
    "    import matplotlib.pyplot as plt\n",
    "    \n",
    "    plt.figure()\n",
    "    plt.imshow(s, cmap='viridis', aspect='auto')\n",
    "    plt.colorbar()\n",
    "    plt.clim(0, 1)  # Set color bar limits\n",
    "    #plt.xlim([0, 4200])\n",
    "    #plt.ylim([0, 4200])\n",
    "    plt.title('Signal Ratio')\n",
    "    plt.grid(False)\n",
    "    plt.show()\n",
    "    \n",
    "    target_edge = round(target_edge * (s.shape[0] / pinhole1.shape[1]))\n",
    "    \n",
    "    length_scale_x = pixels_to_real_units(np.arange(len(s)), params)\n",
    "    length_scale_y = pixels_to_real_units(np.arange(target_edge), params)\n",
    "    \n",
    "    return s_total, did_switch, target_edge\n",
    "\n",
    "\n",
    "def pixels_to_real_units(pixels, params):\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "    from scipy.ndimage import gaussian_filter\n",
    "    \n",
    "    return (36/4) * (1/1050) * (1/params['mag']) * pixels\n",
    "\n",
